HOST_PORT=5010

# Docker Compose Environment Variables Required:
# REDIS
REDIS_CACHE_ENABLED=true
REDIS_CACHE_TTL=60
REDIS_CACHE_PREFIX=message-service
REDIS_AUTH=secret
REDIS_URL=redis:6379
REDIS_HOST_PORT=6399
REDIS_RECONNECT_RETRIES=5
REDIS_RECONNECT_DELAY=5000
REDIS_LOGGING=true
QSERVICE_CACHE_BLACK_LIST_URL_QUERIES=""